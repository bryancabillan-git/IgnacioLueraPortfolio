---
import { site } from '../config';

interface Props {
  label?: string;
}

const { label = 'Ignacio Luera on social media' } = Astro.props;
---

<ul class="social-links" aria-label={label}>
  <li>
    <a class="social-link" href={site.instagramUrl} rel="noreferrer" aria-label="Ignacio Luera on Instagram" title="Instagram">
      <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="17.5" cy="6.5" r="1.15" fill="currentColor" />
      </svg>
      <span class="sr-only">Instagram</span>
    </a>
  </li>
  <li>
    <a class="social-link" href={site.facebookUrl} rel="noreferrer" aria-label="Ignacio Luera on Facebook" title="Facebook">
      <svg viewBox="0 0 24 24" role="img" aria-hidden="true">
        <path d="M14.2 21v-8h2.7l.4-3.1h-3.1v-2c0-.9.3-1.5 1.6-1.5h1.7V3.6c-.8-.1-1.7-.2-2.5-.2-2.5 0-4.2 1.5-4.2 4.3v2.2H8v3.1h2.8v8h3.4Z" fill="currentColor" />
      </svg>
      <span class="sr-only">Facebook</span>
    </a>
  </li>
</ul>
