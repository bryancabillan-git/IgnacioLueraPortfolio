---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The requested page could not be found.">
  <section class="shell page-hero">
    <div>
      <p class="eyebrow">404</p>
      <h1>Lost</h1>
    </div>
    <div class="page-hero-copy">
      <p class="lead">The page you requested could not be found.</p>
      <div class="button-row"><a class="button" href="/">Return home</a></div>
    </div>
  </section>
</BaseLayout>
