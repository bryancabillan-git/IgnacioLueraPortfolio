---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Canva Integration Test" description="Internal Canva OAuth and artwork retrieval test page.">
  <header class="shell page-hero test-page-hero">
    <div>
      <p class="eyebrow">Internal tools</p>
      <h1>Test</h1>
    </div>
    <div class="page-hero-copy">
      <p class="lead">Connect a test Canva account, inspect its folders, retrieve design thumbnails, and verify image exports.</p>
      <p class="test-access-note">This route and its Canva API endpoints require Static Web Apps authentication.</p>
    </div>
  </header>

  <section class="shell section test-dashboard" aria-labelledby="connection-title">
    <article class="test-panel test-connection-panel">
      <div class="test-panel-heading">
        <div>
          <p class="eyebrow">Step 1</p>
          <h2 id="connection-title">OAuth connection</h2>
        </div>
        <span class="status-pill" data-connection-pill>Checking…</span>
      </div>

      <div class="test-status-grid" data-status-grid aria-live="polite">
        <p>Checking the server configuration and connection status.</p>
      </div>

      <div class="button-row">
        <a class="button" href="/api/canva/auth/start" data-connect-button>Connect test Canva account</a>
        <a class="button button-secondary" href="/.auth/logout?post_logout_redirect_uri=/">Sign out of test tools</a>
      </div>
      <p class="test-message" data-oauth-message role="status"></p>
    </article>

    <article class="test-panel" aria-labelledby="folders-title">
      <div class="test-panel-heading">
        <div>
          <p class="eyebrow">Step 2</p>
          <h2 id="folders-title">Choose a folder</h2>
        </div>
      </div>

      <p class="test-instructions">Load the test account’s top-level folders, or paste a known folder ID. The folder ID is saved only in this browser.</p>
      <div class="folder-controls">
        <button class="button button-secondary" type="button" data-load-folders>Load top-level folders</button>
        <label>
          <span>Available folders</span>
          <select data-folder-select>
            <option value="">Select a folder</option>
          </select>
        </label>
        <label>
          <span>Folder ID</span>
          <input data-folder-id type="text" autocomplete="off" placeholder="Canva folder ID" />
        </label>
        <button class="button" type="button" data-load-designs>Pull designs</button>
      </div>
      <p class="test-message" data-folder-message role="status"></p>
    </article>

    <article class="test-panel test-results-panel" aria-labelledby="designs-title">
      <div class="test-panel-heading test-results-heading">
        <div>
          <p class="eyebrow">Step 3</p>
          <h2 id="designs-title">Live Canva results</h2>
        </div>
        <label class="auto-refresh-control">
          <input type="checkbox" data-auto-refresh />
          <span>Refresh every 60 seconds</span>
        </label>
      </div>

      <p class="test-instructions">Thumbnails prove that the OAuth and folder calls work. Select <strong>Test JPG export</strong> to verify Canva’s asynchronous design-export API.</p>
      <p class="test-message" data-design-message role="status">Choose a folder to begin.</p>
      <div class="test-design-grid" data-design-grid></div>
    </article>
  </section>

  <section class="statement-band">
    <div class="shell statement-grid test-next-steps">
      <div>
        <p class="eyebrow eyebrow-light">What this test proves</p>
        <p class="statement-copy">OAuth, token refresh, folder access, live thumbnails, and full JPG exports can be verified before Ignacio authorizes his account.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const connectionPill = document.querySelector<HTMLElement>('[data-connection-pill]');
  const statusGrid = document.querySelector<HTMLElement>('[data-status-grid]');
  const connectButton = document.querySelector<HTMLAnchorElement>('[data-connect-button]');
  const oauthMessage = document.querySelector<HTMLElement>('[data-oauth-message]');
  const loadFoldersButton = document.querySelector<HTMLButtonElement>('[data-load-folders]');
  const folderSelect = document.querySelector<HTMLSelectElement>('[data-folder-select]');
  const folderInput = document.querySelector<HTMLInputElement>('[data-folder-id]');
  const loadDesignsButton = document.querySelector<HTMLButtonElement>('[data-load-designs]');
  const folderMessage = document.querySelector<HTMLElement>('[data-folder-message]');
  const designMessage = document.querySelector<HTMLElement>('[data-design-message]');
  const designGrid = document.querySelector<HTMLElement>('[data-design-grid]');
  const autoRefresh = document.querySelector<HTMLInputElement>('[data-auto-refresh]');
  let refreshTimer: number | undefined;

  async function api<T>(url: string, init?: RequestInit): Promise<T> {
    const response = await fetch(url, {
      ...init,
      headers: { ...(init?.body ? { 'Content-Type': 'application/json' } : {}), ...init?.headers },
    });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || `${response.status} ${response.statusText}`);
    return body as T;
  }

  function setMessage(element: HTMLElement | null, message: string, isError = false) {
    if (!element) return;
    element.textContent = message;
    element.classList.toggle('is-error', isError);
  }

  function statusItem(label: string, value: string) {
    const wrapper = document.createElement('div');
    const term = document.createElement('span');
    const description = document.createElement('strong');
    term.textContent = label;
    description.textContent = value;
    wrapper.append(term, description);
    return wrapper;
  }

  async function loadStatus() {
    try {
      const status = await api<{
        authenticatedAs: string;
        configured: boolean;
        connected: boolean;
        accessTokenActive: boolean;
        redirectUri: string | null;
        tokenStorage: string;
      }>('/api/canva/status');

      if (statusGrid) {
        statusGrid.replaceChildren(
          statusItem('Signed in as', status.authenticatedAs),
          statusItem('Server configuration', status.configured ? 'Ready' : 'Missing settings'),
          statusItem('Canva account', status.connected ? 'Connected' : 'Not connected'),
          statusItem('Token storage', status.tokenStorage),
          statusItem('Redirect URL', status.redirectUri || 'Not configured'),
        );
      }
      if (connectionPill) {
        connectionPill.textContent = status.connected ? 'Connected' : status.configured ? 'Ready to connect' : 'Setup required';
        connectionPill.classList.toggle('is-connected', status.connected);
      }
      if (connectButton) connectButton.textContent = status.connected ? 'Reconnect Canva account' : 'Connect test Canva account';
    } catch (error) {
      if (connectionPill) connectionPill.textContent = 'API unavailable';
      setMessage(oauthMessage, error instanceof Error ? error.message : 'Unable to load status.', true);
    }
  }

  async function loadFolders() {
    if (!loadFoldersButton || !folderSelect) return;
    loadFoldersButton.disabled = true;
    setMessage(folderMessage, 'Loading folders…');
    try {
      const folders = await api<Array<{ id: string; name: string }>>('/api/canva/folders');
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = folders.length ? 'Select a folder' : 'No top-level folders found';
      const options = folders.map((folder) => {
        const option = document.createElement('option');
        option.value = folder.id;
        option.textContent = folder.name;
        return option;
      });
      folderSelect.replaceChildren(placeholder, ...options);
      setMessage(folderMessage, `Found ${folders.length} top-level folder${folders.length === 1 ? '' : 's'}.`);
    } catch (error) {
      setMessage(folderMessage, error instanceof Error ? error.message : 'Unable to load folders.', true);
    } finally {
      loadFoldersButton.disabled = false;
    }
  }

  function renderDesign(design: { id: string; title: string; updatedAt: number; pageCount: number; thumbnail: string | null }) {
    const article = document.createElement('article');
    article.className = 'test-design-card';

    const imageWrap = document.createElement('div');
    imageWrap.className = 'test-design-image';
    if (design.thumbnail) {
      const image = document.createElement('img');
      image.src = design.thumbnail;
      image.alt = `Canva thumbnail for ${design.title}`;
      image.loading = 'lazy';
      image.referrerPolicy = 'no-referrer';
      imageWrap.append(image);
    } else {
      imageWrap.textContent = 'No thumbnail';
    }

    const copy = document.createElement('div');
    copy.className = 'test-design-copy';
    const title = document.createElement('h3');
    title.textContent = design.title;
    const metadata = document.createElement('p');
    metadata.className = 'artwork-meta';
    const updated = design.updatedAt ? new Date(design.updatedAt * 1000).toLocaleString() : 'Unknown';
    metadata.textContent = `${design.pageCount} page${design.pageCount === 1 ? '' : 's'} · Updated ${updated}`;
    const id = document.createElement('code');
    id.textContent = design.id;

    const exportButton = document.createElement('button');
    exportButton.type = 'button';
    exportButton.className = 'filter-button';
    exportButton.textContent = 'Test JPG export';
    const exportStatus = document.createElement('p');
    exportStatus.className = 'test-export-status';
    exportButton.addEventListener('click', () => testExport(design.id, exportButton, exportStatus, imageWrap));

    copy.append(title, metadata, id, exportButton, exportStatus);
    article.append(imageWrap, copy);
    return article;
  }

  async function loadDesigns({ quiet = false } = {}) {
    const folderId = folderInput?.value.trim();
    if (!folderId || !designGrid) {
      setMessage(designMessage, 'Enter or select a Canva folder ID.', true);
      return;
    }

    localStorage.setItem('canva-test-folder-id', folderId);
    if (loadDesignsButton) loadDesignsButton.disabled = true;
    if (!quiet) setMessage(designMessage, 'Pulling the latest designs from Canva…');

    try {
      const designs = await api<Array<{ id: string; title: string; updatedAt: number; pageCount: number; thumbnail: string | null }>>(
        `/api/canva/designs?folderId=${encodeURIComponent(folderId)}`,
      );
      designGrid.replaceChildren(...designs.map(renderDesign));
      setMessage(designMessage, `Pulled ${designs.length} design${designs.length === 1 ? '' : 's'} at ${new Date().toLocaleTimeString()}.`);
    } catch (error) {
      setMessage(designMessage, error instanceof Error ? error.message : 'Unable to pull designs.', true);
    } finally {
      if (loadDesignsButton) loadDesignsButton.disabled = false;
    }
  }

  async function testExport(designId: string, button: HTMLButtonElement, status: HTMLElement, imageWrap: HTMLElement) {
    button.disabled = true;
    setMessage(status, 'Starting Canva export…');
    try {
      let job = await api<{ id: string; status: string; urls?: string[] }>('/api/canva/exports', {
        method: 'POST',
        body: JSON.stringify({ designId }),
      });

      for (let attempt = 0; attempt < 30 && job.status === 'in_progress'; attempt += 1) {
        await new Promise((resolve) => window.setTimeout(resolve, 2000));
        job = await api(`/api/canva/exports/${encodeURIComponent(job.id)}`);
      }

      if (job.status !== 'success' || !job.urls?.length) throw new Error('The export did not complete in time.');
      const image = document.createElement('img');
      image.src = job.urls[0];
      image.alt = 'Successful Canva JPG export preview';
      image.referrerPolicy = 'no-referrer';
      imageWrap.replaceChildren(image);
      setMessage(status, `Export succeeded with ${job.urls.length} image${job.urls.length === 1 ? '' : 's'}.`);
    } catch (error) {
      setMessage(status, error instanceof Error ? error.message : 'Export failed.', true);
    } finally {
      button.disabled = false;
    }
  }

  folderSelect?.addEventListener('change', () => {
    if (folderInput) folderInput.value = folderSelect.value;
  });
  loadFoldersButton?.addEventListener('click', loadFolders);
  loadDesignsButton?.addEventListener('click', () => loadDesigns());
  autoRefresh?.addEventListener('change', () => {
    if (refreshTimer) window.clearInterval(refreshTimer);
    refreshTimer = undefined;
    if (autoRefresh.checked) {
      refreshTimer = window.setInterval(() => {
        if (!document.hidden) loadDesigns({ quiet: true });
      }, 60_000);
      loadDesigns({ quiet: true });
    }
  });

  const savedFolderId = localStorage.getItem('canva-test-folder-id');
  if (folderInput && savedFolderId) folderInput.value = savedFolderId;
  const result = new URLSearchParams(window.location.search).get('canva');
  if (result === 'connected') setMessage(oauthMessage, 'The test Canva account was connected successfully.');
  if (result === 'error') setMessage(oauthMessage, 'Canva authorization failed. Check the API terminal logs and settings.', true);
  loadStatus();
</script>
