---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import ArtworkLightbox from '../components/ArtworkLightbox.astro';
import { featuredArtworks } from '../data/artworks';
import { site } from '../config';
---

<BaseLayout>
  <section class="shell hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{site.role}</p>
      <h1 class="hero-title" id="home-title"><span>Ignacio</span><span>Luera</span></h1>
      <p class="lead">An evolving body of work rooted in memory, identity, place, and community.</p>
      <div class="button-row">
        <a class="button" href="/work/">View the work</a>
        <a class="button button-secondary" href="/about/">About Ignacio</a>
      </div>
    </div>

    <figure class="hero-art">
      <img
        src="/art/mayanignacio.png"
        alt="Blue circular artwork featuring a central portrait surrounded by Mayan-inspired imagery"
        width="717"
        height="793"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="shell section section-rule" aria-labelledby="selected-work-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2 id="selected-work-title">Selected work</h2>
      </div>
      <a class="text-link" href="/work/">Explore all work →</a>
    </div>

    <div class="gallery-grid">
      {featuredArtworks.map((artwork, index) => <ArtworkCard artwork={artwork} eager={index === 0} />)}
    </div>
  </section>

  <section class="statement-band" aria-labelledby="statement-title">
    <div class="shell statement-grid">
      <div>
        <p class="eyebrow eyebrow-light">Artist statement</p>
        <h2 class="sr-only" id="statement-title">Artist statement</h2>
        <p class="statement-copy">Ignacio’s approved artist statement will introduce the ideas, histories, and lived experience behind the work.</p>
        <p class="placeholder-note">Final artist statement pending</p>
      </div>
      <a class="button button-rust" href="/contact/">Contact the artist</a>
    </div>
  </section>

  <ArtworkLightbox />
</BaseLayout>
